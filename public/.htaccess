# ====================================================================
# CẤU HÌNH REWRITE URL CHO HOSTING CPANEL (APACHE / LITESPEED)
# HỆ THỐNG QUẢN LÝ VÀ ĐIỀU HÀNH TRƯỜNG TH&THCS NGUYỄN ĐÌNH ANH
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nếu tệp hoặc thư mục thực tế tồn tại, phục vụ trực tiếp
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Chặn định tuyến API về index.html nếu API endpoint không tồn tại (trả về 404 thực thay vì HTML 200)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [R=404,L]

  # Định tuyến tất cả các đường dẫn giao diện SPA về index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Bảo mật và nén tệp
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cấu hình Cache cho static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

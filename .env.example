# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ==============================================================================
# SUPABASE CONFIGURATION (POSTGRESQL, AUTH, STORAGE)
# ==============================================================================
# Lấy các thông số tại: Supabase Project Dashboard -> Project Settings -> API
# Lưu ý: Tuyệt đối KHÔNG đưa service_role key vào biến môi trường frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Hỗ trợ định dạng cũ (anon key) nếu dự án Supabase của bạn sử dụng tên này:
VITE_SUPABASE_ANON_KEY=
